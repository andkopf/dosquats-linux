#!/usr/bin/python3
"""DoSquats tray icon — the GNOME stand-in for the macOS menu bar item.

Requires the AppIndicator GNOME Shell extension, since GNOME has no native tray:

    sudo dnf install gnome-shell-extension-appindicator

This is a control panel, not a scheduler: the systemd user timer still decides
when reminders fire. Every menu action edits the same ~/.config/dosquats/config.json
the `squats` CLI uses, so the two stay in sync in both directions.
"""

import importlib.machinery
import importlib.util
import subprocess
import sys
import time
from pathlib import Path

import gi

# Fedora ships the classic libappindicator-gtk3; other distros ship Ayatana's fork.
Indicator = None
for _ns in ("AyatanaAppIndicator3", "AppIndicator3"):
    try:
        gi.require_version(_ns, "0.1")
        Indicator = getattr(__import__("gi.repository", fromlist=[_ns]), _ns)
        break
    except (ValueError, ImportError):
        continue
if Indicator is None:
    sys.exit("squats-tray: no AppIndicator library found — "
             "install libappindicator-gtk3 (or libayatana-appindicator-gtk3)")

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gio  # noqa: E402

# The reminder overlay is GTK4 and the tray is GTK3, which cannot share a
# process — so reminders are always fired as a separate `squats` invocation.
SELF_DIR = Path(__file__).resolve().parent
SQUATS = SELF_DIR / "squats"

# spec_from_file_location() returns None for an extension-less file, so the
# loader has to be named explicitly.
_loader = importlib.machinery.SourceFileLoader("squatslib", str(SQUATS))
squatslib = importlib.util.module_from_spec(
    importlib.util.spec_from_loader("squatslib", _loader))
_loader.exec_module(squatslib)

INTERVALS = [5, 10, 15, 20, 30, 45, 60]
OFFSETS = [-10, -5, 0, 5, 10]
REPS = [5, 10, 15, 20, 25, 30, 40, 50]
EXERCISES = ["squats", "pushups", "lunges", "stretches"]


def ask_number(title, prompt, value, lower, upper):
    """Modal spin-button prompt for a rep count outside the presets."""
    dlg = Gtk.Dialog(title=title)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dlg.add_button("OK", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)

    box = dlg.get_content_area()
    box.set_spacing(8)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(12)
    box.add(Gtk.Label(label=prompt))

    spin = Gtk.SpinButton(
        adjustment=Gtk.Adjustment(value=value, lower=lower, upper=upper,
                                  step_increment=1, page_increment=5),
        numeric=True)
    spin.set_activates_default(True)
    box.add(spin)

    dlg.show_all()
    result = int(spin.get_value()) if dlg.run() == Gtk.ResponseType.OK else None
    dlg.destroy()
    return result


def ask_text(title, prompt, value):
    dlg = Gtk.Dialog(title=title)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dlg.add_button("OK", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)

    box = dlg.get_content_area()
    box.set_spacing(8)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(12)
    box.add(Gtk.Label(label=prompt))

    entry = Gtk.Entry(text=value)
    entry.set_activates_default(True)
    box.add(entry)

    dlg.show_all()
    ok = dlg.run() == Gtk.ResponseType.OK
    result = entry.get_text().strip() or None
    dlg.destroy()
    return result if ok else None


def in_words(seconds):
    if seconds >= 3600:
        return f"in {seconds // 3600}h {seconds % 3600 // 60}min"
    if seconds >= 60:
        return f"in {seconds // 60} min"
    return f"in {seconds}s"


def next_fire_label(cfg):
    """'Next: 14:20 (in 9 min)' from the systemd timer's own schedule."""
    until = squatslib.snoozed_until(cfg)
    if until:
        return (f"Snoozed to {time.strftime('%H:%M', time.localtime(until))} "
                f"({in_words(max(0, int(until - time.time())))})")
    try:
        out = subprocess.run(
            ["systemctl", "--user", "show", "dosquats.timer",
             "-p", "NextElapseUSecRealtime", "--value"],
            capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return "Next: unknown"
    if not out or out == "0":
        return "Next: timer not running"

    # systemd prints a raw µs count, a "@<unix>" stamp, or "Tue 2026-08-18
    # 14:20:00 CEST" depending on version and --timestamp settings.
    if out.isdigit():
        when = int(out) / 1_000_000
    elif out.startswith("@"):
        when = float(out[1:].split()[0])
    else:
        try:
            when = time.mktime(time.strptime(" ".join(out.split()[1:3]),
                                             "%Y-%m-%d %H:%M:%S"))
        except (ValueError, IndexError):
            return f"Next: {out}"

    left = max(0, int(when - time.time()))
    when_str = time.strftime("%H:%M", time.localtime(when))
    return f"Next: {when_str} ({in_words(left)})"


def resolve_icon(preferred):
    """First installed icon name that the theme can actually resolve."""
    theme = Gtk.IconTheme.get_default()
    for name in (preferred, "dosquats-symbolic",
                 "emoji-activities-symbolic", "alarm-symbolic"):
        if name and theme.has_icon(name):
            return name
    return "alarm-symbolic"


class Tray:
    def __init__(self):
        self.cfg = squatslib.load_config()
        self.updating = False       # guards against handler/refresh feedback loops

        self.indicator = Indicator.Indicator.new(
            "dosquats", resolve_icon(self.cfg.get("tray_icon")),
            Indicator.IndicatorCategory.APPLICATION_STATUS)
        self.indicator.set_status(Indicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("DoSquats")

        self.build_menu()
        self.refresh()

        GLib.timeout_add_seconds(20, self.refresh)
        self.watch_config()

    # ------------------------------------------------------------ menu ----

    def build_menu(self):
        menu = Gtk.Menu()

        self.next_item = Gtk.MenuItem(label="Next: …")
        self.next_item.set_sensitive(False)
        menu.append(self.next_item)

        menu.append(Gtk.SeparatorMenuItem())

        self.enabled_item = Gtk.CheckMenuItem(label="Reminders enabled")
        self.enabled_item.connect("toggled", self.on_enabled)
        menu.append(self.enabled_item)

        self.skip_item = Gtk.CheckMenuItem(label="Skip next reminder")
        self.skip_item.connect("toggled", self.on_skip)
        menu.append(self.skip_item)

        # Snooze submenu — the presets the reminder itself offers, plus a
        # free-form one and a way out.
        self.snooze_root = Gtk.MenuItem(label="Snooze")
        snooze_menu = Gtk.Menu()
        for mins in squatslib.snooze_options(self.cfg) or [10, 35]:
            item = Gtk.MenuItem(label=f"For {mins} min")
            item.connect("activate", self.on_snooze, mins)
            snooze_menu.append(item)
        custom = Gtk.MenuItem(label="For…")
        custom.connect("activate", self.on_snooze_custom)
        snooze_menu.append(custom)
        snooze_menu.append(Gtk.SeparatorMenuItem())
        self.snooze_cancel = Gtk.MenuItem(label="Cancel snooze")
        self.snooze_cancel.connect("activate", self.on_snooze_cancel)
        snooze_menu.append(self.snooze_cancel)
        self.snooze_root.set_submenu(snooze_menu)
        menu.append(self.snooze_root)

        menu.append(Gtk.SeparatorMenuItem())

        # Interval submenu
        interval_root = Gtk.MenuItem(label="Interval")
        interval_menu = Gtk.Menu()
        self.interval_items = {}
        group = []
        for mins in INTERVALS:
            label = "60 min (hourly)" if mins == 60 else f"{mins} min"
            item = Gtk.RadioMenuItem.new_with_label(group, label)
            group = item.get_group()
            item.connect("toggled", self.on_interval, mins)
            interval_menu.append(item)
            self.interval_items[mins] = item
        interval_root.set_submenu(interval_menu)
        menu.append(interval_root)
        self.interval_root = interval_root

        # Offset submenu — meetings start on the hour, so fire just off it
        self.offset_root = Gtk.MenuItem(label="Offset")
        offset_menu = Gtk.Menu()
        self.offset_items = {}
        group = []
        for mins in OFFSETS:
            label = "On the clock" if mins == 0 else f"{mins:+d} min"
            item = Gtk.RadioMenuItem.new_with_label(group, label)
            group = item.get_group()
            item.connect("toggled", self.on_offset, mins)
            offset_menu.append(item)
            self.offset_items[mins] = item
        self.offset_custom = Gtk.RadioMenuItem.new_with_label(group, "Custom…")
        self.offset_custom.connect("toggled", self.on_offset_custom)
        offset_menu.append(self.offset_custom)
        self.offset_root.set_submenu(offset_menu)
        menu.append(self.offset_root)

        # Reps submenu — presets plus a custom prompt
        self.reps_root = Gtk.MenuItem(label="Reps")
        reps_menu = Gtk.Menu()
        self.reps_items = {}
        group = []
        for count in REPS:
            item = Gtk.RadioMenuItem.new_with_label(group, str(count))
            group = item.get_group()
            item.connect("toggled", self.on_reps, count)
            reps_menu.append(item)
            self.reps_items[count] = item
        self.reps_custom = Gtk.RadioMenuItem.new_with_label(group, "Custom…")
        self.reps_custom.connect("toggled", self.on_reps_custom)
        reps_menu.append(self.reps_custom)
        self.reps_root.set_submenu(reps_menu)
        menu.append(self.reps_root)

        # Exercise submenu — presets plus a custom prompt
        self.exercise_root = Gtk.MenuItem(label="Exercise")
        exercise_menu = Gtk.Menu()
        self.exercise_items = {}
        group = []
        for name in EXERCISES:
            item = Gtk.RadioMenuItem.new_with_label(group, name.capitalize())
            group = item.get_group()
            item.connect("toggled", self.on_exercise, name)
            exercise_menu.append(item)
            self.exercise_items[name] = item
        self.exercise_custom = Gtk.RadioMenuItem.new_with_label(group, "Custom…")
        self.exercise_custom.connect("toggled", self.on_exercise_custom)
        exercise_menu.append(self.exercise_custom)
        self.exercise_root.set_submenu(exercise_menu)
        menu.append(self.exercise_root)

        # Style submenu
        style_root = Gtk.MenuItem(label="Style")
        style_menu = Gtk.Menu()
        self.style_items = {}
        group = []
        for value, label in (("overlay", "Full-screen overlay"),
                             ("banner", "Notification banner")):
            item = Gtk.RadioMenuItem.new_with_label(group, label)
            group = item.get_group()
            item.connect("toggled", self.on_style, value)
            style_menu.append(item)
            self.style_items[value] = item
        style_root.set_submenu(style_menu)
        menu.append(style_root)

        self.sound_item = Gtk.CheckMenuItem(label="Sound")
        self.sound_item.connect("toggled", self.on_sound)
        menu.append(self.sound_item)

        menu.append(Gtk.SeparatorMenuItem())

        now_item = Gtk.MenuItem(label="Remind me now")
        now_item.connect("activate", self.on_now)
        menu.append(now_item)

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", lambda _i: Gtk.main_quit())
        menu.append(quit_item)

        menu.show_all()
        self.indicator.set_menu(menu)

    def refresh(self):
        """Pull config + timer state back into the menu widgets."""
        self.cfg = squatslib.load_config()
        self.updating = True
        try:
            self.next_item.set_label(next_fire_label(self.cfg))
            self.enabled_item.set_active(self.cfg["enabled"])
            self.skip_item.set_active(self.cfg["skip_next"])
            self.sound_item.set_active(self.cfg["sound"])

            until = squatslib.snoozed_until(self.cfg)
            if until:
                stamp = time.strftime("%H:%M", time.localtime(until))
                self.snooze_root.set_label(f"Snooze (until {stamp})")
            else:
                self.snooze_root.set_label("Snooze")
            self.snooze_cancel.set_sensitive(bool(until))

            interval = self.cfg["interval_minutes"]
            if interval in self.interval_items:
                self.interval_items[interval].set_active(True)
            self.interval_root.set_label(f"Interval ({interval} min)")

            offset = squatslib.get_offset(self.cfg)
            self.offset_root.set_label(
                f"Offset ({offset:+d} min)" if offset else "Offset (none)")
            if offset in self.offset_items:
                self.offset_custom.set_label("Custom…")
                self.offset_items[offset].set_active(True)
            else:
                self.offset_custom.set_label(f"Custom… ({offset:+d})")
                self.offset_custom.set_active(True)

            style = self.cfg.get("style", "overlay")
            if style in self.style_items:
                self.style_items[style].set_active(True)

            # Values set from the CLI may fall outside the presets, in which
            # case the Custom… entry carries them.
            reps = self.cfg["reps"]
            self.reps_root.set_label(f"Reps ({reps})")
            if reps in self.reps_items:
                self.reps_custom.set_label("Custom…")
                self.reps_items[reps].set_active(True)
            else:
                self.reps_custom.set_label(f"Custom… ({reps})")
                self.reps_custom.set_active(True)

            exercise = self.cfg["exercise"]
            self.exercise_root.set_label(f"Exercise ({exercise})")
            if exercise in self.exercise_items:
                self.exercise_custom.set_label("Custom…")
                self.exercise_items[exercise].set_active(True)
            else:
                self.exercise_custom.set_label(f"Custom… ({exercise})")
                self.exercise_custom.set_active(True)
        finally:
            self.updating = False
        return GLib.SOURCE_CONTINUE

    def watch_config(self):
        """Reflect `squats` CLI edits in the menu without a restart."""
        squatslib.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        gfile = Gio.File.new_for_path(str(squatslib.CONFIG_FILE))
        self.monitor = gfile.monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_a: self.refresh())

    # -------------------------------------------------------- handlers ----

    def save(self):
        squatslib.save_config(self.cfg)

    def on_enabled(self, item):
        if self.updating:
            return
        self.cfg["enabled"] = item.get_active()
        self.save()

    def on_skip(self, item):
        if self.updating:
            return
        self.cfg["skip_next"] = item.get_active()
        self.save()

    def on_sound(self, item):
        if self.updating:
            return
        self.cfg["sound"] = item.get_active()
        self.save()

    def on_interval(self, item, mins):
        if self.updating or not item.get_active():
            return
        self.cfg["interval_minutes"] = mins
        self.save()
        squatslib.reschedule(self.cfg)
        self.refresh()

    def on_offset(self, item, mins):
        if self.updating or not item.get_active():
            return
        self.cfg["offset_minutes"] = mins
        self.save()
        squatslib.reschedule(self.cfg)
        self.refresh()

    def on_offset_custom(self, item):
        if self.updating or not item.get_active():
            return
        limit = squatslib.OFFSET_LIMIT
        value = ask_number("DoSquats", "Minutes off the clock alignment:",
                           squatslib.get_offset(self.cfg), -limit, limit)
        if value is not None:
            self.cfg["offset_minutes"] = value
            self.save()
            squatslib.reschedule(self.cfg)
        self.refresh()

    def on_snooze(self, _item, mins):
        if self.updating:
            return
        squatslib.start_snooze(self.cfg, mins)
        self.refresh()

    def on_snooze_custom(self, _item):
        if self.updating:
            return
        options = squatslib.snooze_options(self.cfg)
        value = ask_number("DoSquats", "Snooze for how many minutes?",
                           options[0] if options else 10, 1, 240)
        if value:
            squatslib.start_snooze(self.cfg, value)
        self.refresh()

    def on_snooze_cancel(self, _item):
        if self.updating:
            return
        squatslib.cancel_snooze(self.cfg, quiet=True)
        self.refresh()

    def on_reps(self, item, count):
        if self.updating or not item.get_active():
            return
        self.cfg["reps"] = count
        self.save()
        self.refresh()

    def on_reps_custom(self, item):
        if self.updating or not item.get_active():
            return
        value = ask_number("DoSquats", "How many reps per reminder?",
                           self.cfg["reps"], 1, 500)
        if value:
            self.cfg["reps"] = value
            self.save()
        self.refresh()      # also snaps the radio back if the user cancelled

    def on_exercise(self, item, name):
        if self.updating or not item.get_active():
            return
        self.cfg["exercise"] = name
        self.save()
        self.refresh()

    def on_exercise_custom(self, item):
        if self.updating or not item.get_active():
            return
        value = ask_text("DoSquats", "What should the reminder ask for?",
                         self.cfg["exercise"])
        if value:
            self.cfg["exercise"] = value
            self.save()
        self.refresh()

    def on_style(self, item, value):
        if self.updating or not item.get_active():
            return
        self.cfg["style"] = value
        self.save()

    def on_now(self, _item):
        subprocess.Popen([str(SQUATS), "test"])


def main():
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()
