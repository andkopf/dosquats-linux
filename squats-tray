#!/usr/bin/python3
"""DoSquats tray icon — the GNOME stand-in for the macOS menu bar item.

Requires the AppIndicator GNOME Shell extension, since GNOME has no native tray:

    sudo dnf install gnome-shell-extension-appindicator

This is a control panel, not a scheduler: the systemd user timer still decides
when reminders fire. Every menu action edits the same ~/.config/dosquats/config.json
the `squats` CLI uses, so the two stay in sync in both directions.
"""

import importlib.machinery
import importlib.util
import subprocess
import sys
import time
from pathlib import Path

import gi

# Fedora ships the classic libappindicator-gtk3; other distros ship Ayatana's fork.
Indicator = None
for _ns in ("AyatanaAppIndicator3", "AppIndicator3"):
    try:
        gi.require_version(_ns, "0.1")
        Indicator = getattr(__import__("gi.repository", fromlist=[_ns]), _ns)
        break
    except (ValueError, ImportError):
        continue
if Indicator is None:
    sys.exit("squats-tray: no AppIndicator library found — "
             "install libappindicator-gtk3 (or libayatana-appindicator-gtk3)")

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gio  # noqa: E402

# The reminder overlay is GTK4 and the tray is GTK3, which cannot share a
# process — so reminders are always fired as a separate `squats` invocation.
SELF_DIR = Path(__file__).resolve().parent
SQUATS = SELF_DIR / "squats"

# spec_from_file_location() returns None for an extension-less file, so the
# loader has to be named explicitly.
_loader = importlib.machinery.SourceFileLoader("squatslib", str(SQUATS))
squatslib = importlib.util.module_from_spec(
    importlib.util.spec_from_loader("squatslib", _loader))
_loader.exec_module(squatslib)

INTERVALS = [5, 10, 15, 20, 30, 45, 60]


def next_fire_label():
    """'Next: 14:20 (in 9 min)' from the systemd timer's own schedule."""
    try:
        out = subprocess.run(
            ["systemctl", "--user", "show", "dosquats.timer",
             "-p", "NextElapseUSecRealtime", "--value"],
            capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return "Next: unknown"
    if not out or out == "0":
        return "Next: timer not running"

    # systemd prints a raw µs count, a "@<unix>" stamp, or "Tue 2026-08-18
    # 14:20:00 CEST" depending on version and --timestamp settings.
    if out.isdigit():
        when = int(out) / 1_000_000
    elif out.startswith("@"):
        when = float(out[1:].split()[0])
    else:
        try:
            when = time.mktime(time.strptime(" ".join(out.split()[1:3]),
                                             "%Y-%m-%d %H:%M:%S"))
        except (ValueError, IndexError):
            return f"Next: {out}"

    left = max(0, int(when - time.time()))
    when_str = time.strftime("%H:%M", time.localtime(when))
    if left >= 3600:
        return f"Next: {when_str} (in {left // 3600}h {left % 3600 // 60}min)"
    if left >= 60:
        return f"Next: {when_str} (in {left // 60} min)"
    return f"Next: {when_str} (in {left}s)"


class Tray:
    def __init__(self):
        self.cfg = squatslib.load_config()
        self.updating = False       # guards against handler/refresh feedback loops

        self.indicator = Indicator.Indicator.new(
            "dosquats", self.cfg.get("tray_icon", "alarm-symbolic"),
            Indicator.IndicatorCategory.APPLICATION_STATUS)
        self.indicator.set_status(Indicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("DoSquats")

        self.build_menu()
        self.refresh()

        GLib.timeout_add_seconds(20, self.refresh)
        self.watch_config()

    # ------------------------------------------------------------ menu ----

    def build_menu(self):
        menu = Gtk.Menu()

        self.next_item = Gtk.MenuItem(label="Next: …")
        self.next_item.set_sensitive(False)
        menu.append(self.next_item)

        menu.append(Gtk.SeparatorMenuItem())

        self.enabled_item = Gtk.CheckMenuItem(label="Reminders enabled")
        self.enabled_item.connect("toggled", self.on_enabled)
        menu.append(self.enabled_item)

        self.skip_item = Gtk.CheckMenuItem(label="Skip next reminder")
        self.skip_item.connect("toggled", self.on_skip)
        menu.append(self.skip_item)

        menu.append(Gtk.SeparatorMenuItem())

        # Interval submenu
        interval_root = Gtk.MenuItem(label="Interval")
        interval_menu = Gtk.Menu()
        self.interval_items = {}
        group = []
        for mins in INTERVALS:
            label = "60 min (hourly)" if mins == 60 else f"{mins} min"
            item = Gtk.RadioMenuItem.new_with_label(group, label)
            group = item.get_group()
            item.connect("toggled", self.on_interval, mins)
            interval_menu.append(item)
            self.interval_items[mins] = item
        interval_root.set_submenu(interval_menu)
        menu.append(interval_root)

        # Style submenu
        style_root = Gtk.MenuItem(label="Style")
        style_menu = Gtk.Menu()
        self.style_items = {}
        group = []
        for value, label in (("overlay", "Full-screen overlay"),
                             ("banner", "Notification banner")):
            item = Gtk.RadioMenuItem.new_with_label(group, label)
            group = item.get_group()
            item.connect("toggled", self.on_style, value)
            style_menu.append(item)
            self.style_items[value] = item
        style_root.set_submenu(style_menu)
        menu.append(style_root)

        self.sound_item = Gtk.CheckMenuItem(label="Sound")
        self.sound_item.connect("toggled", self.on_sound)
        menu.append(self.sound_item)

        menu.append(Gtk.SeparatorMenuItem())

        now_item = Gtk.MenuItem(label="Remind me now")
        now_item.connect("activate", self.on_now)
        menu.append(now_item)

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", lambda _i: Gtk.main_quit())
        menu.append(quit_item)

        menu.show_all()
        self.indicator.set_menu(menu)

    def refresh(self):
        """Pull config + timer state back into the menu widgets."""
        self.cfg = squatslib.load_config()
        self.updating = True
        try:
            self.next_item.set_label(next_fire_label())
            self.enabled_item.set_active(self.cfg["enabled"])
            self.skip_item.set_active(self.cfg["skip_next"])
            self.sound_item.set_active(self.cfg["sound"])

            interval = self.cfg["interval_minutes"]
            if interval in self.interval_items:
                self.interval_items[interval].set_active(True)
            style = self.cfg.get("style", "overlay")
            if style in self.style_items:
                self.style_items[style].set_active(True)
        finally:
            self.updating = False
        return GLib.SOURCE_CONTINUE

    def watch_config(self):
        """Reflect `squats` CLI edits in the menu without a restart."""
        squatslib.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        gfile = Gio.File.new_for_path(str(squatslib.CONFIG_FILE))
        self.monitor = gfile.monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_a: self.refresh())

    # -------------------------------------------------------- handlers ----

    def save(self):
        squatslib.save_config(self.cfg)

    def on_enabled(self, item):
        if self.updating:
            return
        self.cfg["enabled"] = item.get_active()
        self.save()

    def on_skip(self, item):
        if self.updating:
            return
        self.cfg["skip_next"] = item.get_active()
        self.save()

    def on_sound(self, item):
        if self.updating:
            return
        self.cfg["sound"] = item.get_active()
        self.save()

    def on_interval(self, item, mins):
        if self.updating or not item.get_active():
            return
        self.cfg["interval_minutes"] = mins
        self.save()
        squatslib.reschedule(self.cfg)
        self.refresh()

    def on_style(self, item, value):
        if self.updating or not item.get_active():
            return
        self.cfg["style"] = value
        self.save()

    def on_now(self, _item):
        subprocess.Popen([str(SQUATS), "test"])


def main():
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()
